{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcs.example/schemas/unified-observation-v1.json",
  "title": "PCS Unified Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "domain", "provider", "original_source", "event_type", "timestamp", "retrieved_at", "latitude", "longitude", "country", "region", "value", "unit", "severity_source", "confidence_source", "source_url", "license", "attribution", "pcs_mapping", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "original_source": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "timestamp": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "country": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "value": {"type": ["number", "string", "boolean", "null"]},
    "unit": {"type": ["string", "null"]},
    "severity_source": {"type": ["number", "string", "null"]},
    "confidence_source": {"type": ["number", "string", "null"]},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "license": {"type": ["string", "null"]},
    "attribution": {"type": ["string", "null"]},
    "pcs_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L_T", "L_F", "L_C", "L_I", "L_S"],
      "properties": {
        "L_T": {"type": ["string", "null"]},
        "L_F": {"type": ["string", "null"]},
        "L_C": {"type": ["string", "null"]},
        "L_I": {"type": ["string", "null"]},
        "L_S": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["observation_only", "candidate"]}
  }
}
