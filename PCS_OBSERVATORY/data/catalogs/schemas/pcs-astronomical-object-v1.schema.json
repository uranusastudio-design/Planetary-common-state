{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uranusastudio-design.github.io/Planetary-common-state/schemas/pcs-astronomical-object-v1.schema.json",
  "title": "PCS Known Astronomical Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pcsObjectId", "officialName", "commonName", "aliases", "objectClass", "objectSubtype",
    "catalogIdentifiers", "raDeg", "decDeg", "coordinateFrame", "coordinateEpoch",
    "distance", "distanceLower", "distanceUpper", "distanceUnit", "distanceMethod",
    "parallaxMas", "properMotionRaMasYr", "properMotionDecMasYr", "radialVelocityKmS",
    "redshift", "physicalSize", "angularSize", "mass", "massMethod", "age", "temperatureK",
    "spectralType", "hostStructure", "parentObject", "associatedObjects", "discoveryDate",
    "discoveryMethod", "observationStatus", "evidenceClass", "scientificFidelity",
    "wavelengths", "geometryStatus", "lastUpdated", "dataSources", "researchReferences",
    "knownLimitations"
  ],
  "properties": {
    "pcsObjectId": {"type": "string", "pattern": "^pcs:[a-z0-9][a-z0-9:-]+$"},
    "officialName": {"type": "string", "minLength": 1},
    "commonName": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "objectClass": {"enum": ["nebula", "star-cluster", "stellar-object", "black-hole", "exoplanetary-system", "transient-remnant", "galactic-structure"]},
    "objectSubtype": {"type": ["string", "null"]},
    "catalogIdentifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog", "identifier"],
        "properties": {"catalog": {"type": "string", "minLength": 1}, "identifier": {"type": "string", "minLength": 1}}
      }
    },
    "raDeg": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
    "decDeg": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "coordinateFrame": {"type": ["string", "null"]},
    "coordinateEpoch": {"type": ["string", "null"]},
    "distance": {"type": ["number", "null"], "minimum": 0},
    "distanceLower": {"type": ["number", "null"], "minimum": 0},
    "distanceUpper": {"type": ["number", "null"], "minimum": 0},
    "distanceUnit": {"enum": ["pc", "kpc", "Mpc", null]},
    "distanceMethod": {"type": ["string", "null"]},
    "parallaxMas": {"type": ["number", "null"]},
    "properMotionRaMasYr": {"type": ["number", "null"]},
    "properMotionDecMasYr": {"type": ["number", "null"]},
    "radialVelocityKmS": {"type": ["number", "null"]},
    "redshift": {"type": ["number", "null"]},
    "physicalSize": {"type": ["object", "null"]},
    "angularSize": {"type": ["object", "null"]},
    "mass": {"type": ["object", "null"]},
    "massMethod": {"type": ["string", "null"]},
    "age": {"type": ["object", "null"]},
    "temperatureK": {"type": ["number", "null"], "minimum": 0},
    "spectralType": {"type": ["string", "null"]},
    "hostStructure": {"type": ["string", "null"]},
    "parentObject": {"type": ["string", "null"]},
    "associatedObjects": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "discoveryDate": {"type": ["string", "null"]},
    "discoveryMethod": {"type": ["string", "null"]},
    "observationStatus": {"type": "string", "minLength": 1},
    "evidenceClass": {"enum": ["MEASURED", "CATALOG-DERIVED", "RECONSTRUCTED", "REPRESENTATIVE"]},
    "scientificFidelity": {"enum": ["LA", "LB", "LC", "LD", "LE"]},
    "wavelengths": {"type": "array", "items": {"enum": ["Radio", "Microwave", "Infrared", "Visible", "Ultraviolet", "X-ray", "Gamma-ray"]}, "uniqueItems": true},
    "geometryStatus": {"enum": ["MEASURED_POSITION", "OBSERVED_ANGULAR_EXTENT", "RECONSTRUCTED_3D", "REPRESENTATIVE_VISUALIZATION", "UNAVAILABLE"]},
    "lastUpdated": {"type": "string", "format": "date"},
    "dataSources": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "researchReferences": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "knownLimitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "blackHoleStatus": {"enum": ["CONFIRMED", "DYNAMICALLY_SUPPORTED", "STRONG_CANDIDATE", "CANDIDATE", "UNCERTAIN", null]}
  }
}
